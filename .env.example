# ==============================================================================
# PULSE HEALTH - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide your values.
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# ==============================================================================

# Core Application Settings
APP_NAME="Pulse Health"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Configuration (PostgreSQL in production; SQLite supported for local dev)
DATABASE_URL="file:./dev.db"

# Authentication Security (Generate using: openssl rand -base64 32)
AUTH_SECRET="your-32-character-secret-key-change-in-production"
AUTH_SESSION_MAX_AGE="2592000" # 30 days in seconds

# Demo / Mock Mode Flag (Set to "true" to enable mock data generator & providers)
DEMO_MODE="true"

# ------------------------------------------------------------------------------
# HEALTH DATA PROVIDERS (OAuth 2.0 Credentials)
# Note: Providers without credentials will operate in safe mock mode when DEMO_MODE=true
# ------------------------------------------------------------------------------

# Apple Health / HealthKit Integration
# Requires Apple Developer Account with HealthKit entitlement
APPLE_HEALTH_CLIENT_ID=""
APPLE_HEALTH_CLIENT_SECRET=""
APPLE_HEALTH_REDIRECT_URI="http://localhost:3000/api/auth/callback/apple"

# Google Health Connect / Google Fit
# Requires Google Cloud Console Project with Fitness API / Health Connect enabled
GOOGLE_HEALTH_CLIENT_ID=""
GOOGLE_HEALTH_CLIENT_SECRET=""
GOOGLE_HEALTH_REDIRECT_URI="http://localhost:3000/api/auth/callback/google-health"

# Fitbit Web API
# Requires Fitbit Developer App registration (Personal or Server type)
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""
FITBIT_REDIRECT_URI="http://localhost:3000/api/auth/callback/fitbit"

# Garmin Health API
# Requires Garmin Health enterprise developer agreement and access
GARMIN_CLIENT_ID=""
GARMIN_CLIENT_SECRET=""
GARMIN_REDIRECT_URI="http://localhost:3000/api/auth/callback/garmin"

# Oura Cloud API v2
# Requires Oura Developer Account application
OURA_CLIENT_ID=""
OURA_CLIENT_SECRET=""
OURA_REDIRECT_URI="http://localhost:3000/api/auth/callback/oura"

# ------------------------------------------------------------------------------
# OPTIONAL SERVICES & EXTENSIONS
# ------------------------------------------------------------------------------

# Groq Ultra-Fast AI Engine (Recommended for high speed)
GROQ_API_KEY=""

# AI / Metabolic Insight Engine (Groq / OpenAI compatible endpoint)
AI_API_KEY=""
AI_API_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="openai/gpt-oss-120b"

# Pulse Food AI & Nutrition Services
FOOD_AI_PROVIDER="groq" # "groq", "gemini", or "demo"
FOOD_AI_API_KEY=""      # Groq or Gemini API key (server-side only, never client-exposed)
FOOD_AI_API_BASE_URL="https://api.groq.com/openai/v1"
FOOD_AI_MODEL="qwen/qwen3.8-27b"
NUTRITION_PROVIDER="demo" # "usda" or "demo"
NUTRITION_API_KEY=""     # USDA FoodData Central API key (optional)
FOOD_IMAGE_MAX_SIZE_MB="8"

# Pulse Community & Moderation Engine
COMMUNITY_MODERATION_PROVIDER="rules_fallback" # "groq", "gemini", or "rules_fallback"
COMMUNITY_MODERATION_API_KEY=""
COMMUNITY_MODERATION_API_BASE_URL="https://api.groq.com/openai/v1"
COMMUNITY_MODERATION_MODEL="llama-3.3-70b-versatile"

# Pulse Proactive Care Engine
PROACTIVE_AI_PROVIDER="rules_fallback" # "groq", "gemini", or "rules_fallback"
PROACTIVE_AI_API_KEY=""
PROACTIVE_AI_MODEL="llama-3.3-70b-versatile"
PROACTIVE_MAX_DAILY_INTERVENTIONS="2"
PROACTIVE_COOLDOWN_HOURS="4"
SCHEDULER_SECRET=""
NOTIFICATION_PROVIDER="in_app" # "in_app", "email", or "push"

# Object Storage (S3 / Cloud Storage for user profile images and reports)
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Email Notifications (SendGrid, Postmark, Resend, or AWS SES)
EMAIL_API_KEY=""
EMAIL_FROM="notifications@pulsehealth.app"

# Application Monitoring
SENTRY_DSN=""

# Internal Product Analytics Abstraction
ANALYTICS_WRITE_KEY=""
NEXT_PUBLIC_ANALYTICS_ENABLED="true"

# ------------------------------------------------------------------------------
# PAYMENT & SUBSCRIPTION GATEWAY (Razorpay Subscriptions - Recurring INR ₹499/mo)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER="razorpay" # "razorpay" or "mock"
# Public Key ID for Razorpay Standard Checkout modal (safe for client-side init)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
# Private Key Secret (Server-side HMAC verification only - NEVER commit or expose to client)
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
# Webhook signing secret (For verifying x-razorpay-signature on incoming webhook events)
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
# Recurring Plan ID created in Razorpay Dashboard (₹499/month INR)
RAZORPAY_PLAN_ID="plan_pulse_premium_499"

